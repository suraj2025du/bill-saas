{
  "name": "free-gst-billing",
  "private": true,
  "version": "1.0.0",
  "description": "Free, offline-first GST billing, inventory and accounting app (React + Express). Runs in the browser (IndexedDB) or on your PC (server.js on 127.0.0.1:47371).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "copy-ocr": "node scripts/copy-ocr-assets.mjs",
    "package": "node scripts/package-release.mjs",
    "heal:nightly": "node scripts/heal-nightly.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "express": "^5.3.0",
    "html2canvas-pro": "^2.5.0",
    "idb": "^8.0.4",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.64.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "minimatch@^10": "^11.0.4",
    "workbox-build": {
      "glob": "^14.0.3"
    }
  }
}
