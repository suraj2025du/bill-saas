# Copy to .env (git-ignored) only if you need to override defaults. No secrets are required.
# Folder for the JSON database files (default: ./_system/data)
GST_DATA_DIR=
# Folder for automatic daily backups (default: ./_system/backups)
GST_BACKUP_DIR=
# Port for the local server (default: 47371). The server always binds to 127.0.0.1.
PORT=
